      "rawSql": "SELECT $__timeGroupAlias(\"startTime\", $__interval), CASE WHEN model_group IN ('glm52', 'glm5.1-w8a8', 'glm53', 'glm5.1') THEN 'glm-text' WHEN model_group IN ('deepseek-v4-flash', 'deepseek-v4-flash0731') THEN 'deepseek-v4-flash' ELSE COALESCE(NULLIF(model_group, ''), '<none>') END AS metric, ROUND(AVG(completion_tokens::numeric / NULLIF(prompt_tokens, 0)), 3) AS out_in_ratio FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") AND status = 'success' AND prompt_tokens > 0 AND api_key IN (${key_group:sqlstring}) AND (\"prompt_tokens\" + \"completion_tokens\") >= 150 GROUP BY 1, 2 ORDER BY 1, 2",
