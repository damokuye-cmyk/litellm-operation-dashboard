      "rawQuery": true,
      "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE status = 'success') / NULLIF(COUNT(*) FILTER (WHERE status = 'success' OR NOT (metadata->'error_information'->>'error_class' IN ('BadRequestError','UnsupportedParamsError','AuthenticationError') OR metadata->'error_information'->>'error_code' IN ('400','401','403') OR metadata->'error_information'->>'error_message' ~* '(invalid model name|key not allowed to access model|does not support parameters|unsupported chat content part|not a multimodal model|unterminated string|cannot be greater than|at most [0-9]+ image|unexpected keyword argument|only support the value)')), 0), 2) AS success_rate FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") AND api_key IN (${key_group:sqlstring})",
      "refId": "A"
     }
    ],
    "title": "Success Rate (excl. client param errors)",
    "type": "stat"
