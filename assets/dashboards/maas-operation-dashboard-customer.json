    "description": "Total glm53-flash requests containing at least one image_url part in proxy_server_request.messages. Scope: selected time range + key group.",
    "fieldConfig": {
     "defaults": {
      "color": {
       "fixedColor": "orange",
       "mode": "fixed"
      },
      "mappings": [],
      "thresholds": {
       "mode": "absolute",
