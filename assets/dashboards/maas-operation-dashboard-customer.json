      },
      "editorMode": "code",
      "format": "time_series",
      "rawQuery": true,
      "rawSql": "SELECT $__timeGroupAlias(\"startTime\", $bucket), CASE WHEN api_key = 'SEARCH_AGENT_KEY' THEN 'Search Agent' WHEN model_group IN ('glm52', 'glm5.1-w8a8', 'glm53', 'glm5.1') THEN 'glm-text' WHEN model_group IN ('deepseek-v4-flash', 'deepseek-v4-flash0731') THEN 'deepseek-v4-flash' WHEN model_group = 'glm53-flash' THEN 'glm53-flash(s)' ELSE COALESCE(NULLIF(model_group, ''), '<none>') END AS metric, ROUND(AVG(EXTRACT(EPOCH FROM (\"endTime\" - \"completionStartTime\")) * 1000 / NULLIF(completion_tokens, 0))::numeric, 1) AS tpot_ms FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") AND status = 'success' AND \"completionStartTime\" > \"startTime\" AND proxy_server_request->>'stream' = 'true' AND EXTRACT(EPOCH FROM (\"endTime\" - \"completionStartTime\")) >= 1 AND completion_tokens > 0 AND api_key IN (${key_group:sqlstring}) GROUP BY 1, 2 ORDER BY 1, 2",
      "refId": "A"
     },
     {
      "datasource": {
       "type": "postgres",
       "uid": "P98809E0A67B9D897"
      },
      "editorMode": "code",
      "format": "time_series",
      "rawQuery": true,
      "rawSql": "SELECT $__timeGroupAlias(\"startTime\", $bucket),\n  'glm53-flash (n+s)' AS metric,\n  ROUND(AVG(\n    CASE\n      WHEN COALESCE(proxy_server_request->>'stream','false') <> 'true'\n        THEN (EXTRACT(EPOCH FROM (\"endTime\" - \"startTime\")) * 1000 - 1000) / NULLIF(completion_tokens, 0)\n      ELSE EXTRACT(EPOCH FROM (\"endTime\" - \"completionStartTime\")) * 1000 / NULLIF(completion_tokens, 0)\n    END\n  )::numeric, 1) AS tpot_ms\nFROM \"LiteLLM_SpendLogs\"\nWHERE $__timeFilter(\"startTime\")\n  AND status = 'success'\n  AND model_group = 'glm53-flash'\n  AND \"endTime\" > \"startTime\"\n  AND completion_tokens > 0\n  AND api_key IN (${key_group:sqlstring})\n  AND (\n    (COALESCE(proxy_server_request->>'stream','false') <> 'true'\n       AND EXTRACT(EPOCH FROM (\"endTime\" - \"startTime\")) * 1000 > 1000)\n    OR (proxy_server_request->>'stream' = 'true'\n       AND \"completionStartTime\" > \"startTime\"\n       AND EXTRACT(EPOCH FROM (\"endTime\" - \"completionStartTime\")) >= 1)\n  )\nGROUP BY 1, 2\nORDER BY 1, 2",
      "refId": "B"
     }
    ],
    "title": "N5 TPOT per $bucket (ms/output tok; glm53-flash(s) stream only, (n+s) approx 1s TTFT)",
    "type": "timeseries"
