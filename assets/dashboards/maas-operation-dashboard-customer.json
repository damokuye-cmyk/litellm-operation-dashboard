    "gridPos": {
     "h": 4,
     "w": 4,
     "x": 20,
     "y": 1
    },
    "id": 29,
    "options": {
     "colorMode": "value",
     "graphMode": "none",
     "justifyMode": "auto",
     "orientation": "auto",
     "percentChangeColorMode": "standard",
     "reduceOptions": {
      "calcs": [
       "lastNotNull"
      ],
      "fields": "/^image_requests$/",
      "values": false
     },
     "showPercentChange": false,
     "textMode": "auto",
     "wideLayout": true
    },
    "pluginVersion": "11.2.2",
    "targets": [
     {
      "datasource": {
       "type": "grafana-postgresql-datasource",
       "uid": "P98809E0A67B9D897"
      },
      "editorMode": "code",
      "format": "table",
      "rawQuery": true,
      "rawSql": "SELECT COUNT(*) AS image_requests\nFROM \"LiteLLM_SpendLogs\" s\nCROSS JOIN LATERAL (\n  SELECT count(*) AS imgs\n  FROM jsonb_array_elements(\n    CASE WHEN jsonb_typeof(s.proxy_server_request->'messages')='array'\n         THEN s.proxy_server_request->'messages' ELSE '[]'::jsonb END) m\n  CROSS JOIN LATERAL jsonb_array_elements(\n    CASE WHEN jsonb_typeof(m->'content')='array' THEN m->'content' ELSE '[]'::jsonb END) c\n  WHERE c->>'type'='image_url'\n) ic\nWHERE $__timeFilter(s.\"startTime\")\n  AND s.api_key IN (${key_group:sqlstring})\n  AND s.model_group = 'glm53-flash'\n  AND ic.imgs > 0",
      "refId": "A"
     }
    ],
    "title": "Image Requests (glm53-flash)",
    "type": "stat"
   },
