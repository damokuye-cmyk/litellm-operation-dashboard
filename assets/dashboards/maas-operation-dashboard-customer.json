      "rawSql": "SELECT CASE WHEN api_key = 'SEARCH_AGENT_KEY' THEN 'Search Agent' WHEN model_group IN ('glm52', 'glm5.1-w8a8', 'glm53', 'glm5.1') THEN 'glm-text' WHEN model_group IN ('deepseek-v4-flash', 'deepseek-v4-flash0731') THEN 'deepseek-v4-flash' ELSE COALESCE(NULLIF(model_group, ''), '<none>') END AS model_group, ROUND(SUM(total_tokens)) AS total_tokens, COUNT(*) AS request_count, ROUND(SUM(prompt_tokens)) AS total_input_tokens, SUM(completion_tokens) AS total_output_tokens, ROUND(AVG(prompt_tokens) FILTER (WHERE \"prompt_tokens\" + \"completion_tokens\" >= 150)) AS avg_input_tokens, ROUND(AVG(completion_tokens) FILTER (WHERE \"prompt_tokens\" + \"completion_tokens\" >= 150)) AS avg_output_tokens, ROUND(MAX(prompt_tokens)) AS max_input_tokens, MAX(completion_tokens) AS max_output_tokens, ROUND(MAX(prompt_tokens + completion_tokens)) AS max_tokens FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") AND api_key IN (${key_group:sqlstring}) GROUP BY 1 ORDER BY total_tokens DESC",
      "refId": "A"
     }
    ],
    "title": "N7 Model Group Business Data Sheet",
    "type": "table"
   },
